{
  "name": "@dipu01-code/simplestore",
  "version": "1.0.0",
  "description": "Beginner-friendly, cross-platform local storage abstraction for Web and React Native",
  "author": "Dipu",
  "license": "MIT",
  "homepage": "https://github.com/dipu01-code/npm_package-project#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipu01-code/npm_package-project.git"
  },
  "keywords": [
    "storage",
    "localstorage",
    "async-storage",
    "react-native",
    "expo",
    "web",
    "key-value",
    "typescript",
    "simplestore"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./web": {
      "types": "./dist/esm/web.d.ts",
      "import": "./dist/esm/web.js",
      "require": "./dist/cjs/web.js"
    },
    "./react-native": {
      "types": "./dist/esm/react-native.d.ts",
      "import": "./dist/esm/react-native.js",
      "require": "./dist/cjs/react-native.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/web.ts src/react-native.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test && npm run typecheck"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
